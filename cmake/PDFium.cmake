set(HUXERUI_PDF_PDFIUM_ROOT "$ENV{HUXERUI_PDF_PDFIUM_ROOT}" CACHE PATH "PDFium SDK (include, lib, bin)")
option(HUXERUI_PDF_FETCH_PDFIUM "Download a pinned PDFium desktop SDK when no SDK is supplied" ON)

if(TARGET PDFium::PDFium)
    return()
endif()

if(NOT HUXERUI_PDF_PDFIUM_ROOT AND HUXERUI_PDF_FETCH_PDFIUM)
    if(CMAKE_CROSSCOMPILING OR ANDROID OR IOS OR EMSCRIPTEN)
        message(FATAL_ERROR "Cross builds require HUXERUI_PDF_PDFIUM_ROOT or an existing PDFium::PDFium target")
    endif()
    string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" _pdf_cpu)
    if(WIN32 AND (CMAKE_GENERATOR_PLATFORM STREQUAL "ARM64" OR CMAKE_CXX_COMPILER_ARCHITECTURE_ID STREQUAL "ARM64"))
        set(_pdf_asset win-arm64)
        set(_pdf_hash 5e04abdb36ba9b4b5c8630123eaf042036f8a62abda6e5529708fee3d35fbf4f)
    elseif(WIN32 AND CMAKE_SIZEOF_VOID_P EQUAL 8 AND NOT CMAKE_GENERATOR_PLATFORM MATCHES "ARM")
        set(_pdf_asset win-x64)
        set(_pdf_hash 8d48973e3eb472dda0f5f2435e595ac043f9f2219dd71883392f549445afa8a5)
    elseif(APPLE AND (CMAKE_OSX_ARCHITECTURES STREQUAL "arm64" OR
            (NOT CMAKE_OSX_ARCHITECTURES AND _pdf_cpu MATCHES "^(arm64|aarch64)$")))
        set(_pdf_asset mac-arm64)
        set(_pdf_hash 21a1567b397b571f4f77f21ca91eac7b892774219c3c715a5127a20950ccb18b)
    elseif(APPLE AND (CMAKE_OSX_ARCHITECTURES STREQUAL "x86_64" OR
            (NOT CMAKE_OSX_ARCHITECTURES AND _pdf_cpu MATCHES "^(x86_64|amd64)$")))
        set(_pdf_asset mac-x64)
        set(_pdf_hash 72662ac8eff7bf5381ef82ceebd0a0ad5bddb051b303981115114e6972fd201c)
    elseif(APPLE AND CMAKE_OSX_ARCHITECTURES MATCHES "^(arm64;x86_64|x86_64;arm64)$")
        set(_pdf_asset mac-univ)
        set(_pdf_hash bbc85a8306409267bcca6d961f0b416cde1fac2423411f5c14ab02b0b3e689fd)
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND _pdf_cpu MATCHES "^(arm64|aarch64)$")
        set(_pdf_asset linux-arm64)
        set(_pdf_hash c70b1ce4d13257f741af19e0aeee575890875995eb81370a65be942e601a1862)
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND _pdf_cpu MATCHES "^(x86_64|amd64)$")
        set(_pdf_asset linux-x64)
        set(_pdf_hash d6b1e28950a0392590d79bbdbb7eb19686872b688f8a36f170acb19e41473113)
    else()
        message(FATAL_ERROR "Supply HUXERUI_PDF_PDFIUM_ROOT for this architecture")
    endif()
    include(FetchContent)
    if(POLICY CMP0135)
        cmake_policy(SET CMP0135 NEW)
    endif()
    FetchContent_Declare(huxerui_pdfium
        URL "https://github.com/bblanchon/pdfium-binaries/releases/download/chromium/8138/pdfium-${_pdf_asset}.tgz"
        URL_HASH "SHA256=${_pdf_hash}")
    FetchContent_MakeAvailable(huxerui_pdfium)
    set(_pdf_root "${huxerui_pdfium_SOURCE_DIR}")
else()
    set(_pdf_root "${HUXERUI_PDF_PDFIUM_ROOT}")
endif()
if(NOT _pdf_root)
    message(FATAL_ERROR "Set HUXERUI_PDF_PDFIUM_ROOT or enable HUXERUI_PDF_FETCH_PDFIUM")
endif()

find_path(_pdf_include fpdfview.h PATHS "${_pdf_root}/include" NO_DEFAULT_PATH REQUIRED)
add_library(PDFium::PDFium UNKNOWN IMPORTED GLOBAL)
if(WIN32)
    find_library(_pdf_library NAMES pdfium.dll pdfium PATHS "${_pdf_root}/lib" NO_DEFAULT_PATH REQUIRED)
    find_file(_pdf_runtime pdfium.dll PATHS "${_pdf_root}/bin" NO_DEFAULT_PATH)
    if(_pdf_runtime)
        set(HUXERUI_PDF_RUNTIME_FILE "${_pdf_runtime}" CACHE INTERNAL "PDFium runtime to deploy" FORCE)
    endif()
else()
    find_library(_pdf_library NAMES pdfium PATHS "${_pdf_root}/lib" NO_DEFAULT_PATH REQUIRED)
endif()
set_target_properties(PDFium::PDFium PROPERTIES
    IMPORTED_LOCATION "${_pdf_library}"
    INTERFACE_INCLUDE_DIRECTORIES "${_pdf_include}")
