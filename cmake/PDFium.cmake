set(HUXERUI_PDF_PDFIUM_ROOT "$ENV{HUXERUI_PDF_PDFIUM_ROOT}" CACHE PATH "PDFium SDK (include, lib, bin)")
option(HUXERUI_PDF_FETCH_PDFIUM "Download a pinned PDFium desktop SDK when no SDK is supplied" ON)

if(TARGET PDFium::PDFium)
    return()
endif()

if(NOT HUXERUI_PDF_PDFIUM_ROOT AND HUXERUI_PDF_FETCH_PDFIUM)
    set(_pdf_asset)
    set(_pdf_hash)
    if(ANDROID)
        if(ANDROID_ABI STREQUAL "arm64-v8a")
            set(_pdf_asset android-arm64)
            set(_pdf_hash fc73c8020d7204e52f7a9d8153489b3cac2e9c5dc5d70d3a37a976a7398c1a86)
        elseif(ANDROID_ABI STREQUAL "x86_64")
            set(_pdf_asset android-x64)
            set(_pdf_hash cf71ceb527d72a64b3e8bf36e9b15b326984f56d33bb8b74350a92ab8706ba87)
        else()
            message(FATAL_ERROR
                "No pinned PDFium SDK for Android ABI '${ANDROID_ABI}'; supply HUXERUI_PDF_PDFIUM_ROOT")
        endif()
    elseif(IOS)
        list(LENGTH CMAKE_OSX_ARCHITECTURES _pdf_arch_count)
        if(_pdf_arch_count EQUAL 0)
            set(_pdf_arch "${CMAKE_SYSTEM_PROCESSOR}")
        elseif(_pdf_arch_count EQUAL 1)
            set(_pdf_arch "${CMAKE_OSX_ARCHITECTURES}")
        else()
            message(FATAL_ERROR
                "Pinned PDFium downloads support one iOS architecture per build; "
                "select a single CMAKE_OSX_ARCHITECTURES entry or supply HUXERUI_PDF_PDFIUM_ROOT")
        endif()
        string(TOLOWER "${_pdf_arch}" _pdf_arch)
        if(_pdf_arch STREQUAL "aarch64")
            set(_pdf_arch arm64)
        elseif(_pdf_arch STREQUAL "amd64")
            set(_pdf_arch x86_64)
        endif()
        string(TOLOWER "${CMAKE_OSX_SYSROOT}" _pdf_sysroot)
        if(_pdf_sysroot MATCHES "simulator")
            if(_pdf_arch STREQUAL "arm64")
                set(_pdf_asset ios-simulator-arm64)
                set(_pdf_hash 7e2d50b1dbe1d4f9e4b28a575a0f69423b5f2150f30b3303455a39669dd70c61)
            elseif(_pdf_arch STREQUAL "x86_64")
                set(_pdf_asset ios-simulator-x64)
                set(_pdf_hash 5696940a4e3adf1e2bca4010d69ce500d3ffadc1e740bc4df957349fb8fdbd98)
            else()
                message(FATAL_ERROR
                    "No pinned PDFium simulator SDK for iOS architecture '${_pdf_arch}'; "
                    "supply HUXERUI_PDF_PDFIUM_ROOT")
            endif()
        elseif(_pdf_arch STREQUAL "arm64")
            set(_pdf_asset ios-device-arm64)
            set(_pdf_hash d2acc4d9c24fa3bd002415e89c8a52a1936da823215283315dfab2070e465698)
        else()
            message(FATAL_ERROR
                "No pinned PDFium device SDK for iOS architecture '${_pdf_arch}'; "
                "supply HUXERUI_PDF_PDFIUM_ROOT")
        endif()
    elseif(EMSCRIPTEN)
        message(FATAL_ERROR "Web builds require HUXERUI_PDF_PDFIUM_ROOT or an existing PDFium::PDFium target")
    elseif(CMAKE_CROSSCOMPILING)
        message(FATAL_ERROR "Cross builds require HUXERUI_PDF_PDFIUM_ROOT or an existing PDFium::PDFium target")
    else()
        string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" _pdf_cpu)
        if(WIN32 AND (CMAKE_GENERATOR_PLATFORM STREQUAL "ARM64" OR CMAKE_CXX_COMPILER_ARCHITECTURE_ID STREQUAL "ARM64"))
            set(_pdf_asset win-arm64)
            set(_pdf_hash 5e04abdb36ba9b4b5c8630123eaf042036f8a62abda6e5529708fee3d35fbf4f)
        elseif(WIN32 AND CMAKE_SIZEOF_VOID_P EQUAL 8 AND NOT CMAKE_GENERATOR_PLATFORM MATCHES "ARM")
            set(_pdf_asset win-x64)
            set(_pdf_hash 8d48973e3eb472dda0f5f2435e595ac043f9f2219dd71883392f549445afa8a5)
        elseif(APPLE AND (CMAKE_OSX_ARCHITECTURES STREQUAL "arm64" OR
                (NOT CMAKE_OSX_ARCHITECTURES AND _pdf_cpu MATCHES "^(arm64|aarch64)$")))
            set(_pdf_asset mac-arm64)
            set(_pdf_hash 21a1567b397b571f4f77f21ca91eac7b892774219c3c715a5127a20950ccb18b)
        elseif(APPLE AND (CMAKE_OSX_ARCHITECTURES STREQUAL "x86_64" OR
                (NOT CMAKE_OSX_ARCHITECTURES AND _pdf_cpu MATCHES "^(x86_64|amd64)$")))
            set(_pdf_asset mac-x64)
            set(_pdf_hash 72662ac8eff7bf5381ef82ceebd0a0ad5bddb051b303981115114e6972fd201c)
        elseif(APPLE AND CMAKE_OSX_ARCHITECTURES MATCHES "^(arm64;x86_64|x86_64;arm64)$")
            set(_pdf_asset mac-univ)
            set(_pdf_hash bbc85a8306409267bcca6d961f0b416cde1fac2423411f5c14ab02b0b3e689fd)
        elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND _pdf_cpu MATCHES "^(arm64|aarch64)$")
            set(_pdf_asset linux-arm64)
            set(_pdf_hash c70b1ce4d13257f741af19e0aeee575890875995eb81370a65be942e601a1862)
        elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND _pdf_cpu MATCHES "^(x86_64|amd64)$")
            set(_pdf_asset linux-x64)
            set(_pdf_hash d6b1e28950a0392590d79bbdbb7eb19686872b688f8a36f170acb19e41473113)
        else()
            message(FATAL_ERROR "Supply HUXERUI_PDF_PDFIUM_ROOT for this architecture")
        endif()
    endif()
    include(FetchContent)
    if(POLICY CMP0135)
        cmake_policy(SET CMP0135 NEW)
    endif()
    string(REPLACE "-" "_" _pdf_fetch_suffix "${_pdf_asset}")
    set(_pdf_fetch_name "huxerui_pdfium_${_pdf_fetch_suffix}")
    FetchContent_Declare(${_pdf_fetch_name}
        URL "https://github.com/bblanchon/pdfium-binaries/releases/download/chromium/8138/pdfium-${_pdf_asset}.tgz"
        URL_HASH "SHA256=${_pdf_hash}")
    FetchContent_MakeAvailable(${_pdf_fetch_name})
    set(_pdf_root "${${_pdf_fetch_name}_SOURCE_DIR}")
else()
    set(_pdf_root "${HUXERUI_PDF_PDFIUM_ROOT}")
endif()
if(NOT _pdf_root)
    message(FATAL_ERROR "Set HUXERUI_PDF_PDFIUM_ROOT or enable HUXERUI_PDF_FETCH_PDFIUM")
endif()

find_path(_pdf_include fpdfview.h PATHS "${_pdf_root}/include"
    NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH REQUIRED)
add_library(PDFium::PDFium UNKNOWN IMPORTED GLOBAL)
if(WIN32)
    find_library(_pdf_library NAMES pdfium.dll pdfium PATHS "${_pdf_root}/lib"
        NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH REQUIRED)
    find_file(_pdf_runtime pdfium.dll PATHS "${_pdf_root}/bin"
        NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
    if(_pdf_runtime)
        set(HUXERUI_PDF_RUNTIME_FILE "${_pdf_runtime}" CACHE INTERNAL "PDFium runtime to deploy" FORCE)
    endif()
else()
    if(APPLE)
        # Apple find_library also probes .framework bundles; the pinned SDKs use libpdfium.dylib.
        find_file(_pdf_library NAMES libpdfium.dylib PATHS "${_pdf_root}/lib"
            NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH REQUIRED)
    else()
        find_library(_pdf_library NAMES pdfium PATHS "${_pdf_root}/lib"
            NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH REQUIRED)
    endif()
    if(APPLE AND _pdf_library MATCHES "\\.dylib$")
        # The binary distributor uses ./libpdfium.dylib as its install name.
        # Normalize a build-local copy so consumers can resolve it through RPATH.
        # Never rewrite an explicitly supplied SDK in place.
        set(_pdf_local_library "${CMAKE_CURRENT_BINARY_DIR}/pdfium-runtime/libpdfium.dylib")
        configure_file("${_pdf_library}" "${_pdf_local_library}" COPYONLY)
        find_program(_pdf_install_name_tool install_name_tool REQUIRED)
        find_program(_pdf_codesign codesign REQUIRED)
        execute_process(COMMAND "${_pdf_install_name_tool}" -id "@rpath/libpdfium.dylib" "${_pdf_local_library}"
            COMMAND_ERROR_IS_FATAL ANY)
        execute_process(COMMAND "${_pdf_codesign}" --force --sign - "${_pdf_local_library}"
            COMMAND_ERROR_IS_FATAL ANY)
        set(_pdf_library "${_pdf_local_library}")
    endif()
endif()
set_target_properties(PDFium::PDFium PROPERTIES
    IMPORTED_LOCATION "${_pdf_library}"
    INTERFACE_INCLUDE_DIRECTORIES "${_pdf_include}")
